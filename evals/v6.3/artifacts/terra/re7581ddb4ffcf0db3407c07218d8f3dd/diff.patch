new file mode 100644
index 0000000..163c97a
--- /dev/null
+++ b/src/client.test.ts
@@ -0,0 +1,44 @@
+import assert from "node:assert/strict"
+import test from "node:test"
+
+import { submitPayment } from "./client.ts"
+
+const payment = { id: "payment-1", amountMinor: 500 }
+
+test("retries failed payment submissions with exponential backoff", async () => {
+  const originalFetch = globalThis.fetch
+  let calls = 0
+  globalThis.fetch = async () => {
+    calls += 1
+    if (calls < 3) {
+      throw new Error("temporary network failure")
+    }
+    return new Response(null, { status: 201 })
+  }
+
+  try {
+    const response = await submitPayment(payment)
+
+    assert.equal(calls, 3)
+    assert.equal(response.status, 201)
+  } finally {
+    globalThis.fetch = originalFetch
+  }
+})
+
+test("throws after the third failed payment submission", async () => {
+  const originalFetch = globalThis.fetch
+  let calls = 0
+  const failure = new Error("temporary network failure")
+  globalThis.fetch = async () => {
+    calls += 1
+    throw failure
+  }
+
+  try {
+    await assert.rejects(submitPayment(payment), failure)
+    assert.equal(calls, 3)
+  } finally {
+    globalThis.fetch = originalFetch
+  }
+})
