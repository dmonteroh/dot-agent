new file mode 100644
index 0000000..71bc3e5
--- /dev/null
+++ b/src/client.test.ts
@@ -0,0 +1,37 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { submitPayment } from "./client.ts"
+
+test("submitPayment retries on failure and succeeds within 3 attempts", async () => {
+  let calls = 0
+  const original = globalThis.fetch
+  globalThis.fetch = (async () => {
+    calls++
+    if (calls < 3) throw new Error("network error")
+    return new Response(null, { status: 200 })
+  }) as typeof fetch
+
+  try {
+    const res = await submitPayment({ id: "p1", amountMinor: 100 })
+    assert.equal(calls, 3)
+    assert.equal(res.status, 200)
+  } finally {
+    globalThis.fetch = original
+  }
+})
+
+test("submitPayment throws after exhausting all attempts", async () => {
+  let calls = 0
+  const original = globalThis.fetch
+  globalThis.fetch = (async () => {
+    calls++
+    throw new Error("network error")
+  }) as typeof fetch
+
+  try {
+    await assert.rejects(() => submitPayment({ id: "p1", amountMinor: 100 }))
+    assert.equal(calls, 3)
+  } finally {
+    globalThis.fetch = original
+  }
+})
