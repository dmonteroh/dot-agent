new file mode 100644
index 0000000..bd3e1f8
--- /dev/null
+++ b/src/client.test.ts
@@ -0,0 +1,19 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { submitRefund } from "./client.ts"
+
+test("submitRefund posts to the vendor refunds endpoint", async (t) => {
+  const calls: [RequestInfo | URL, RequestInit | undefined][] = []
+  t.mock.method(globalThis, "fetch", async (url: RequestInfo | URL, init?: RequestInit) => {
+    calls.push([url, init])
+    return new Response(null, { status: 200 })
+  })
+
+  const res = await submitRefund({ paymentId: "pay_1", amountMinor: 500 })
+
+  assert.equal(res.status, 200)
+  assert.equal(calls.length, 1)
+  assert.equal(calls[0][0], "https://vendor.example/v1/refunds")
+  assert.equal(calls[0][1]?.method, "POST")
+  assert.equal(calls[0][1]?.body, JSON.stringify({ paymentId: "pay_1", amountMinor: 500 }))
+})
