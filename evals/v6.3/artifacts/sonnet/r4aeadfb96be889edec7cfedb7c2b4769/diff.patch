+++ b/test/client.test.ts
@@ -0,0 +1,20 @@
+import { test } from "node:test"
+import assert from "node:assert"
+import { submitPayment } from "../src/client.ts"
+
+test("submitPayment sends an Idempotency-Key header matching the payment id", async () => {
+  const originalFetch = globalThis.fetch
+  let capturedInit: RequestInit | undefined
+  globalThis.fetch = (async (_url: string, init?: RequestInit) => {
+    capturedInit = init
+    return new Response(null, { status: 200 })
+  }) as typeof fetch
+
+  try {
+    await submitPayment({ id: "pay_123", amountMinor: 500 })
+  } finally {
+    globalThis.fetch = originalFetch
+  }
+
+  assert.strictEqual((capturedInit?.headers as Record<string, string>)["Idempotency-Key"], "pay_123")
+})
