@@ -0,0 +1,24 @@
+import { test } from "node:test"
+import assert from "node:assert"
+import { submitPayment } from "../src/client.ts"
+
+test("submitPayment sends an Idempotency-Key header equal to the payment id", async () => {
+  const calls: [string, RequestInit | undefined][] = []
+  const originalFetch = globalThis.fetch
+  // @ts-expect-error test stub
+  globalThis.fetch = async (url: string, init?: RequestInit) => {
+    calls.push([url, init])
+    return new Response(null, { status: 200 })
+  }
+
+  try {
+    await submitPayment({ id: "pay_123", amountMinor: 500 })
+  } finally {
+    globalThis.fetch = originalFetch
+  }
+
+  assert.strictEqual(calls.length, 1)
+  const [, init] = calls[0]
+  const headers = init?.headers as Record<string, string>
+  assert.strictEqual(headers["Idempotency-Key"], "pay_123")
+})
