new file mode 100644
index 0000000..06401d9
--- /dev/null
+++ b/src/client.test.ts
@@ -0,0 +1,31 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { submitPayment } from "./client.ts"
+
+test("retries on failure and succeeds within max attempts", async () => {
+  let calls = 0
+  const ok = new Response(null, { status: 200 })
+  global.fetch = (async () => {
+    calls++
+    if (calls < 3) throw new Error("network error")
+    return ok
+  }) as typeof fetch
+
+  const res = await submitPayment({ id: "p1", amountMinor: 100 })
+  assert.equal(res, ok)
+  assert.equal(calls, 3)
+})
+
+test("gives up after max attempts and throws the last error", async () => {
+  let calls = 0
+  global.fetch = (async () => {
+    calls++
+    throw new Error("network error")
+  }) as typeof fetch
+
+  await assert.rejects(
+    () => submitPayment({ id: "p2", amountMinor: 100 }),
+    /network error/,
+  )
+  assert.equal(calls, 3)
+})
diff --git a/src/client.ts b/src/client.ts
