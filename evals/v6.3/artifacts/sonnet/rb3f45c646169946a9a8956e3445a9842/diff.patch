new file mode 100644
index 0000000..ec7c7f2
--- /dev/null
+++ b/src/client.test.ts
@@ -0,0 +1,26 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { submitRefund } from "./client.ts"
+
+test("submitRefund posts to the vendor refunds endpoint", async () => {
+  const calls: Array<{ url: string; init: RequestInit }> = []
+  const originalFetch = globalThis.fetch
+  globalThis.fetch = (async (url: string, init: RequestInit) => {
+    calls.push({ url: String(url), init })
+    return new Response(null, { status: 200 })
+  }) as typeof fetch
+
+  try {
+    await submitRefund({ paymentId: "pay_1", amountMinor: 500 })
+  } finally {
+    globalThis.fetch = originalFetch
+  }
+
+  assert.equal(calls.length, 1)
+  assert.equal(calls[0].url, "https://vendor.example/v1/refunds")
+  assert.equal(calls[0].init.method, "POST")
+  assert.deepEqual(JSON.parse(calls[0].init.body as string), {
+    paymentId: "pay_1",
+    amountMinor: 500,
+  })
+})
